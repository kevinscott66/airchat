    "expo-network": "^55.0.9",
    "expo-secure-store": "^55.0.9",
    "expo-sharing": "~55.0.18",
    "expo-sms": "~55.0.9",
    "expo-splash-screen": "~55.0.12",
    "expo-sqlite": "^55.0.11",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.10",
    "expo-video": "~55.0.19",
    "helia": "^6.0.22",
    "i18next": "^26.0.6",
    "interface-blockstore": "^6.0.1",
    "it-all": "^3.0.9",
    "key-did-resolver": "^4.0.0",
    "kubo-rpc-client": "^6.1.0",
    "libp2p": "^3.1.6",
    "multiformats": "^13.4.2",
    "os-browserify": "^0.3.0",
