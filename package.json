{
  "name": "airchat",
  "version": "4.32.812",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:build": "expo run:android",
    "android:build:standalone-debug": "bash scripts/android-gradle.sh :app:assembleDebug -Pairchat.bundleInDebug=true",
    "android:install:standalone-debug": "bash scripts/android-gradle.sh :app:installDebug -Pairchat.bundleInDebug=true",
    "android:release": "bash scripts/build-release.sh android",
    "android:bundle-release": "bash scripts/android-gradle.sh :app:bundleRelease",
    "android:logs": "adb logcat -v time ReactNativeJS:V ReactNative:W AndroidRuntime:E '*:S'",
    "ios": "expo run:ios",
    "ios:prebuild": "expo prebuild --platform ios",
    "ios:device": "expo run:ios --device",
    "ios:sim": "expo run:ios",
    "test": "jest",
    "test:servers": "npm --prefix signaling-server test && npm --prefix server/cloud-vault test",
    "test:full": "npm run check:scripts && npm run typecheck && npm run lint && npm test -- --runInBand && npm run test:servers",
    "check:scripts": "node scripts/check-package-scripts.js",
    "check-ui": "bash scripts/check-ui.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "doc": "typedoc --entryPoints src/core/index.ts --out docs/api --skipErrorChecking",
    "e2e:web": "node e2e/web/run.js",
    "deploy:signaling": "bash scripts/deploy-server.sh signaling",
    "deploy:vault": "bash scripts/deploy-server.sh cloud-vault",
    "signaling": "cd signaling-server && node index.js",
    "prebuild:native": "expo prebuild --clean",
    "build:release": "bash scripts/build-release.sh",
    "version:bump": "bash scripts/bump-version.sh",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "web:budget": "node scripts/web-bundle-budget.js dist",
    "postinstall": "node scripts/ensure-expo-image-picker-swift.js"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.0.2",
    "@helia/unixfs": "^7.1.0",
    "@libp2p/bootstrap": "^12.0.14",
    "@libp2p/websockets": "^10.1.6",
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/ed25519": "^3.0.1",
    "@noble/hashes": "^2.0.1",
    "@notifee/react-native": "^9.1.8",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/messaging": "^23.8.8",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/native-stack": "^7.14.6",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "^2.3.0",
    "airchat-openflux": "file:./modules/airchat-openflux",
    "airchat-vpn": "file:./modules/airchat-vpn",
    "babel-preset-expo": "~55.0.8",
    "bip39": "^3.1.0",
    "blockstore-core": "^6.1.2",
    "buffer": "^6.0.3",
    "datastore-core": "^11.0.2",
    "did-jwt": "^8.0.18",
    "did-resolver": "^4.1.0",
    "event-target-shim": "^6.0.2",
    "events": "^3.3.0",
    "expo": "~55.0.8",
    "expo-apple-authentication": "~55.0.17",
    "expo-asset": "~55.0.10",
    "expo-audio": "~55.0.18",
    "expo-battery": "~55.0.17",
    "expo-blur": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-camera": "~55.0.23",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "^55.0.9",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "^55.0.11",
    "expo-font": "~55.0.8",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-location": "~55.1.14",
    "expo-media-library": "~55.0.21",
    "expo-network": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.18",
    "expo-sms": "~55.0.18",
    "expo-splash-screen": "~55.0.12",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "expo-video": "~55.0.21",
    "helia": "^6.0.22",
    "i18next": "^26.0.6",
    "interface-blockstore": "^6.0.1",
    "it-all": "^3.0.9",
    "key-did-resolver": "^4.0.0",
    "kubo-rpc-client": "^6.1.0",
    "libp2p": "^3.1.6",
    "multiformats": "^13.4.2",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.4",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-web": "^0.21.0",
    "react-native-webrtc": "^124.0.7",
    "react-native-wifi-p2p": "^3.6.1",
    "react-native-zeroconf": "^0.14.0",
    "readable-stream": "^4.7.0",
    "socket.io-client": "^4.8.3",
    "stream-browserify": "^3.0.0",
    "uint8arrays": "^5.1.0",
    "util": "^0.12.5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-jest": "~29.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "~29.7.0",
    "jest-circus": "~29.7.0",
    "jest-expo": "^55.0.11",
    "ts-jest": "^29.4.6",
    "typedoc": "^0.28.0",
    "typescript": "~5.9.2",
    "zod": "^3.25.76"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@notifee/react-native",
          "airchat-openflux",
          "airchat-screen-guard",
          "airchat-vpn",
          "react-native-tcp-socket",
          "react-native-webrtc",
          "react-native-wifi-p2p"
        ]
      }
    }
  }
}
