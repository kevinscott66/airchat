{
  "name": "airchat",
  "version": "4.32.551",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "bash scripts/expo-android.sh",
    "android:phone": "bash scripts/expo-android-phone.sh",
    "metro:usb": "bash scripts/metro-usb.sh",
    "android:install-phone": "bash scripts/install-android-debug-on-phone.sh",
    "android:build": "expo run:android",
    "android:build:standalone-debug": "cd android && ./gradlew :app:assembleDebug -Pairchat.bundleInDebug=true",
    "android:install:standalone-debug": "cd android && ./gradlew :app:installDebug -Pairchat.bundleInDebug=true",
    "android:build:share-apk": "bash scripts/build-share-apk.sh",
    "ios": "expo run:ios",
    "ios:prebuild": "expo prebuild --platform ios",
    "ios:device": "bash scripts/ios-device.sh",
    "ios:sim": "expo run:ios",
    "e2e:build:ios": "detox build -c ios.sim.debug",
    "e2e:ios": "detox test -c ios.sim.debug",
    "test": "jest",
    "test:full": "npm run typecheck && npm run lint && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "doc": "typedoc --entryPoints src/core/index.ts --out docs/api --skipErrorChecking",
    "e2e": "detox test -c android.emu.debug",
    "e2e:build": "detox build -c android.emu.debug",
    "e2e:android": "detox test -c android.emu.debug",
    "e2e:android:ci": "detox test -c android.ci.debug",
    "e2e:android:device": "detox test -c android.att.debug",
    "e2e:build:device": "detox build -c android.att.debug",
    "e2e:full": "detox test -c android.emu.debug e2e/full-flow.e2e.js",
    "e2e:transport": "detox test -c android.att.debug e2e/transport.e2e.js",
    "e2e:two-devices": "node e2e/two-devices-test.js",
    "e2e:two-devices:bash": "bash scripts/auto-cross-test.sh",
    "e2e:two-devices:full": "bash -c 'RESET_APP=${RESET_APP:-1} bash scripts/auto-cross-test.sh'",
    "deploy:signaling": "cd signaling-server && flyctl deploy --local-only",
    "deploy:landing": "flyctl deploy --local-only --config fly.toml",
    "android:bundle-release": "bash scripts/android-bundle-release.sh",
    "android:emulator-setup": "bash scripts/setup-android-emulator.sh",
    "android:emulator": "bash scripts/start-android-emulator.sh",
    "android:logs": "bash scripts/android-logs.sh",
    "android:log-save": "bash scripts/save-adb-device-log.sh",
    "lan-ip": "bash scripts/show-lan-ip.sh",
    "check-ui": "bash scripts/check-ui.sh",
    "cross-test": "bash scripts/auto-cross-test.sh",
    "test:transports": "bash scripts/test-transports.sh",
    "test:android:transports:full": "bash scripts/android-full-transport-test.sh",
    "test:full-auto": "bash scripts/full-auto-test.sh",
    "test:full-auto:60": "WAIT_TIME=60 bash scripts/full-auto-test.sh",
    "signaling": "cd signaling-server && node index.js",
    "prebuild:native": "expo prebuild --clean",
    "build:release": "bash scripts/build-release.sh",
    "android:release": "cd android && ./gradlew bundleRelease",
    "keystore:generate": "bash -c 'mkdir -p android && keytool -genkey -v -keystore android/airchat-release.keystore -alias airchat -keyalg RSA -keysize 2048 -validity 10000'",
    "postinstall": "node scripts/ensure-expo-image-picker-swift.js",
    "web": "expo start --web",
    "web:export": "expo export --platform web"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
