{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  // Собранный бандл headless-ядра — результат сборки, а не исходник: внутри
  // склеенные зависимости на всех диалектах сразу, и проверять их типами
  // бессмысленно. Сами исходники в node-host/ проверяются как обычно.
  "exclude": ["node-host/dist"]
}
