{
  "expo": {
    "name": "airchat",
    "slug": "airchat",
    "owner": "dobropalm",
    "version": "4.32.584",
    "scheme": "airchat",
    "plugins": [
      "./plugins/withFirebaseModularHeaders"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tech.dobropalm.airchat",
      "buildNumber": "584",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "AirChat использует камеру для съёмки фото и видео в чатах.",
        "NSMicrophoneUsageDescription": "AirChat использует микрофон для звонков и записи голосовых сообщений.",
        "NSPhotoLibraryUsageDescription": "AirChat использует доступ к фото для отправки изображений в чатах.",
        "NSPhotoLibraryAddUsageDescription": "AirChat сохраняет полученные медиа в вашу галерею.",
        "NSLocationWhenInUseUsageDescription": "AirChat использует геолокацию для отправки вашего местоположения в чатах.",
        "NSFaceIDUsageDescription": "AirChat использует Face ID для защиты ваших ключей и секретной фразы.",
        "NSLocalNetworkUsageDescription": "AirChat ищет собеседников в локальной сети Wi-Fi для прямой доставки без интернета.",
        "UIBackgroundModes": [
          "remote-notification",
          "audio"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "tech.dobropalm.airchat",
      "allowBackup": false,
      "permissions": [
        "android.permission.USE_FULL_SCREEN_INTENT"
      ],
      "googleServicesFile": "./google-services.json",
      "versionCode": 584,
      "adaptiveIcon": {
        "backgroundColor": "#0B0B12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "AirChat",
      "shortName": "AirChat",
      "themeColor": "#0B0B12",
      "backgroundColor": "#0B0B12",
      "display": "standalone",
      "lang": "en",
      "output": "single"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "extra": {
      "eas": {
        "projectId": "583951f6-0a65-415a-945e-fd308bea7fe7"
      }
    }
  }
}
