# Environment variable template. No values are stored in the repository —
# copy this file to .env and fill in your own.

# Sentry DSN for crash reporting. Empty disables reporting.
EXPO_PUBLIC_SENTRY_DSN=

# Адрес облачной копии и каталога @имён (server/cloud-vault). Пусто — в сборке
# нет облачной копии, синхронизации аккаунта и перехода по @имени незнакомца.
EXPO_PUBLIC_CLOUD_VAULT_URL=

# Ссылка на документ Яндекса, через который работает туннель OpenFlux
# (нужен старый редактор и доступ на запись по ссылке; проверить —
# OpenFlux/check-doc.sh). Это фактически ключ: писать в документ сможет
# каждый, у кого есть ссылка, поэтому в репозитории её нет. Пусто — туннеля
# в сборке нет, приложение работает напрямую.
EXPO_PUBLIC_OPENFLUX_DOC_URL=

# Apple Team ID for iOS signing (alternative to ios-signing.local).
APPLE_TEAM_ID=

# Experimental educational modules: development only.
EXPO_PUBLIC_ENABLE_EDUCATIONAL_MODULES=false
