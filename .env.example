# Environment variable template. No values are stored in the repository —
# copy this file to .env and fill in your own.

# Sentry DSN for crash reporting. Empty disables reporting.
EXPO_PUBLIC_SENTRY_DSN=

# Apple Team ID for iOS signing (alternative to ios-signing.local).
APPLE_TEAM_ID=

# Experimental educational modules: development only.
EXPO_PUBLIC_ENABLE_EDUCATIONAL_MODULES=false
