[Unit]
Description=AirChat cloud vault: обновление таблицы «IP → страна» из файлов RIR
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=airchat-vault
Environment=CLOUD_VAULT_DIR=/var/lib/airchat-cloud-vault-example
# Keep the builder on the same Node runtime as the vault.  The system package
# on the VPS may be older than Node 22, whereas node:sqlite is a hard runtime
# requirement of the service and its tooling.
ExecStart=/opt/node-v22.14.0-linux-x64/bin/node /opt/airchat-cloud-vault-example/tools/build-geoip.js
# Сборщик пишет через временный файл и переименование, поэтому сервису
# перезапуск не нужен: таблица читается с диска и подхватится сама.
TimeoutStartSec=900
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/airchat-cloud-vault-example
