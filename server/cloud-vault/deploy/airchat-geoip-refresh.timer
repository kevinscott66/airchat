[Unit]
Description=Еженедельное обновление таблицы «IP → страна»

[Timer]
# Реестры публикуют файлы ежедневно, но страна за блоком меняется годами.
# Раз в неделю со случайным сдвигом: пять чужих ftp не должны получать
# запрос ровно в полночь от всех, кто скопировал этот таймер.
OnCalendar=weekly
RandomizedDelaySec=6h
Persistent=true

[Install]
WantedBy=timers.target
