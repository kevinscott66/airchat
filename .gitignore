# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Переменные окружения. Игнорируется весь .env*, а не только .env*.local:
# Expo читает и голый `.env`, и `.env.production`, а класть в них есть что —
# EXPO_PUBLIC_SENTRY_DSN и APPLE_TEAM_ID (см. app.config.js, core/errorHandler).
# Прежнее правило ловило только `.env*.local`, то есть самый вероятный файл
# уехал бы в репозиторий. Образец без значений — исключение.
.env
.env.*
!.env.example
# Team ID для подписи iOS — у каждой машины свой, в репозиторий не едет.
ios-signing.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Локальные модули (modules/) — исходники в репозитории, результаты сборки нет.
# Сами модули подключены как file:./modules/... в package.json, поэтому без них
# свежий клон не проходит npm install; а вот android/build — это 380 МБ вывода
# Gradle, который пересобирается из тех же исходников.
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/
modules/*/node_modules/
modules/*/build/

# Резервные копии файлов, оставленные редакторами и ручными правками.
*.bak
# Локальные выгрузки веб-сборки (dist-533, dist-web530, dist-map …): тот же
# вывод, что и dist/, только под именем версии — в репозиторий не едет.
dist-*/

# FCM service account: доступ на отправку пушей от имени проекта.
# Скачивается из консоли Firebase и уезжает в секрет окружения, не сюда
# (см. docs/push-setup.md). google-services.json и GoogleService-Info.plist
# в репозитории лежат заглушками — в них нет ничего секретного.
service-account*.json
*-firebase-adminsdk-*.json

# Локальная база cloud-vault: рантайм-артефакт, не исходник.
server/cloud-vault/data/

# Скомпилированный Xray-core для модуля VPN (~73 МБ на две ABI). README рядом
# с каталогом говорит, что бинарники сюда не коммитятся, но правила не было —
# и `git add -A` утащил бы их в публичный репозиторий.
# Тем же правилом ловится ядро OpenFlux (12 МБ) — его собирает
# scripts/build-openflux-android.sh.
modules/*/android/src/main/jniLibs/*/*.so
# Заголовок C-API ядра OpenFlux: генерируется тем же скриптом из исходников
# ядра, то есть такой же результат сборки, как и .so рядом.
modules/airchat-openflux/android/src/main/cpp/include/libopenflux.h
# То же ядро под iOS: два статических среза (устройство и симулятор) по 15 МБ,
# собирает scripts/build-openflux-ios.sh. В отличие от Android, заголовок
# C-API здесь НЕ артефакт сборки — OpenFluxCoreAPI.h написан руками и лежит в
# git, иначе модуль не собрался бы в свежем клоне (см. README.md рядом).
modules/airchat-openflux/ios/OpenFlux.xcframework/

# Манифест локальной релизной сборки (scripts/build-release.sh).
release/
build/ios/
